# Bulk downloads (1 GB+): re-pull with the SODA URLs in docs/SOURCES.md S3/S4
data/raw/*
!data/raw/.gitkeep
# ...but keep the small archived source evidence (raw API responses and data dictionaries)
!data/raw/qcmobile_samples/
!data/raw/vpic_sample.json
!data/raw/census_readme.txt
!data/raw/crash_data_dictionary.pdf
# Cache: the sqlite index over census.csv is rebuilt locally; the API response caches are kept so a fresh clone
# reproduces the real-carrier book check offline (checked: no webKey in any response file)
data/cache/*
!data/cache/carrier/
!data/cache/vin/
# data/census_slim.csv.gz IS committed (19 MB, python -m analysis.build_census_slim): without a census snapshot a
# live-fetched carrier has no registration date, so a fresh clone would price a different book. Not ignored here.
__pycache__/
*.pyc
.env
.venv/
.pytest_cache/
# Presentation prep: kept local, not part of the submission. The rest of docs/ IS the submission --
# RATIONALE and SOURCES are what the brief asks for by name, so do not widen this to the folder.
docs/WALKTHROUGH.md
docs/DEMO_RUNBOOK.md
docs/PRESENTATION_OUTLINE.md
docs/CLAUDE_CODE_PROMPTS.md
